# Docker-Desktop-Konfiguration für Windows.
# Diese Datei nach .env.windows kopieren und bei Bedarf anpassen.
#
# Start:
#   docker compose --env-file .env.windows -f compose.windows.yaml pull
#   docker compose --env-file .env.windows -f compose.windows.yaml up -d
#
# Warum eine eigene Compose-Datei: network_mode: host bezieht sich unter
# Docker Desktop nur auf die Linux-VM. compose.windows.yaml nutzt deshalb
# Portmapping und bindet Node im Container an 0.0.0.0.

# Lokale HTTP-Origin. Mehrere Werte sind kommasepariert erlaubt.
# Für Zugriff aus dem LAN z. B.:
# APP_ORIGIN=http://127.0.0.1:621,http://192.168.1.10:621
# Dann in compose.windows.yaml das Portmapping auf "621:621" ändern.
APP_ORIGIN=http://127.0.0.1:621
