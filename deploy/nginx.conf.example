# Replace example.invalid and both certificate paths before enabling this config.
# Nginx terminates HTTPS on the same host as the Node process.
# Start Node with APP_ORIGIN=https://example.invalid after choosing the public domain.
server {
    listen 80;
    server_name example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name example.invalid;

    ssl_certificate /absolute/path/to/fullchain.pem;
    ssl_certificate_key /absolute/path/to/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        proxy_pass http://127.0.0.1:621;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
